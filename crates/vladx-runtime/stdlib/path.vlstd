// путь — как path в Node (разделитель «/»). Написан целиком на VladX.

импортируй строки
импортируй списки

// соедини("a", "b/c") или соедини(["a", "b", "c"]) → "a/b/c"
функция соедини(первая, вторая = ничего) {
  изменяй части станет первая
  если ядро.тип(первая) не равно "список" то {
    части станет [первая]
    если вторая не равно ничего то {
      части станет [первая, вторая]
    }
  }
  пусть непустые будет списки.отбери(части, функция(ч) {
    верни строка(ч) не равно ""
  })
  верни нормализуй(ядро.соедини(непустые, "/"))
}

// убрать «.», «..» и повторные «/»
функция нормализуй(п: строка) {
  пусть абсолютный будет строки.начинается(п, "/")
  пусть итог будет []
  для каждого ч из ядро.раздели(п, "/") {
    если ч равно "" или ч равно "." то {
      продолжи
    }
    если ч равно ".." и ядро.длина(итог) больше 0 и списки.последний(итог) не равно ".." то {
      ядро.вынь(итог)
    } иначе {
      если ч не равно ".." или не абсолютный то {
        ядро.добавь(итог, ч)
      }
    }
  }
  пусть тело будет ядро.соедини(итог, "/")
  если абсолютный то {
    верни "/" + тело
  }
  если тело равно "" то {
    верни "."
  }
  верни тело
}

// последняя часть: "a/b/c.txt" → "c.txt"
функция имя(п: строка) {
  пусть части будет ядро.раздели(п, "/")
  изменяй i станет ядро.длина(части) - 1
  пока i больше 0 и ядро.элемент(части, i) равно "" {
    i станет i - 1
  }
  верни ядро.элемент(части, i)
}

// "c.txt" → ".txt"; у ".скрытый" и "файл" — ""
функция расширение(п: строка) {
  пусть н будет имя(п)
  изменяй точка станет -1
  изменяй i станет 0
  для каждого знак из ядро.символы(н) {
    если знак равно "." то {
      точка станет i
    }
    i станет i + 1
  }
  если точка меньше или равно 0 то {
    верни ""
  }
  верни ядро.кусок_строки(н, точка)
}

функция без_расширения(п: строка) {
  пусть н будет имя(п)
  верни ядро.кусок_строки(н, 0, ядро.длина(н) - ядро.длина(расширение(н)))
}

// папка: "a/b/c.txt" → "a/b"; "c.txt" → "."
функция папка(п: строка) {
  пусть части будет ядро.раздели(нормализуй(п), "/")
  если ядро.длина(части) меньше 2 то {
    если строки.начинается(п, "/") то {
      верни "/"
    }
    верни "."
  }
  пусть тело будет ядро.соедини(ядро.кусок_списка(части, 0, ядро.длина(части) - 1), "/")
  если тело равно "" то {
    верни "/"
  }
  верни тело
}
