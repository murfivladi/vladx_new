// события — как EventEmitter в Node. Написан целиком на VladX: источник —
// объект с прототипом, обработчики — список функций на каждое событие.
//
//   импортируй события
//   пусть кнопка будет события.источник()
//   кнопка.на("нажата", функция(кто) { скажи "нажал {кто}" })
//   кнопка.сообщи("нажата", "Аня")

// подписаться; возвращает источник (можно цепочкой)
функция _на(событие: строка, обработчик: функция) {
  пусть все будет _обработчики(это, событие)
  ядро.добавь(все, обработчик)
  верни это
}

// подписаться на один раз
функция _один_раз(событие: строка, обработчик: функция) {
  пусть источник будет это
  изменяй обёртка станет ничего
  обёртка станет функция(данные) {
    _снять(источник, событие, обёртка)
    обработчик(данные)
  }
  ядро.добавь(_обработчики(источник, событие), обёртка)
  верни источник
}

функция _сними(событие: строка, обработчик: функция) {
  _снять(это, событие, обработчик)
  верни это
}

// вызвать обработчики по порядку; истина, если они были
функция _сообщи(событие: строка, данные = ничего) {
  пусть все будет ядро.кусок_списка(_обработчики(это, событие), 0)
  для каждого обработчик из все {
    обработчик(данные)
  }
  верни ядро.длина(все) больше 0
}

функция _слушатели(событие: строка) {
  верни ядро.длина(_обработчики(это, событие))
}

функция _обработчики(источник, событие) {
  пусть таблица будет источник._обработчики
  если не ядро.есть_ключ(таблица, событие) то {
    ядро.задай_поле(таблица, событие, [])
  }
  верни ядро.поле(таблица, событие)
}

функция _снять(источник, событие, обработчик) {
  пусть было будет _обработчики(источник, событие)
  пусть осталось будет []
  изменяй снят станет ложь
  для каждого ф из было {
    если не снят и ядро.равны(ф, обработчик) то {
      снят станет истина
    } иначе {
      ядро.добавь(осталось, ф)
    }
  }
  ядро.задай_поле(источник._обработчики, событие, осталось)
}

// методы на русском и итальянском — одни и те же функции
пусть _прототип будет {
  на: _на,
  один_раз: _один_раз,
  сними: _сними,
  сообщи: _сообщи,
  слушатели: _слушатели,
  su: _на,
  una_volta: _один_раз,
  togli: _сними,
  emetti: _сообщи,
  ascoltatori: _слушатели
}

функция источник() {
  верни создай объект с прототипом _прототип {
    _обработчики: {}
  }
}
