// проверка — как assert в Node: проверки в тестах. Провал — ошибка E-ASSERT-001,
// её ловит «попробуй», а без «попробуй» программа останавливается с понятным сообщением.

функция провал(сообщение: строка = "проверка не прошла") {
  ядро.ошибка("E-ASSERT-001", сообщение)
}

функция истинно(значение, сообщение = ничего) {
  если не значение то {
    провал(_или(сообщение, "ожидалась истина, получено «{значение}»"))
  }
}

функция одинаково(получено, ожидалось, сообщение = ничего) {
  если не ядро.равны(получено, ожидалось) то {
    провал(_или(сообщение, "ожидалось «{ожидалось}», получено «{получено}»"))
  }
}

функция различно(а, б, сообщение = ничего) {
  если ядро.равны(а, б) то {
    провал(_или(сообщение, "значения не должны совпадать: «{а}»"))
  }
}

// ф() должна бросить ошибку (с кодом, если он указан); возвращает пойманное
функция бросает(ф: функция, код = ничего) {
  изменяй пойманное станет ничего
  изменяй брошено станет ложь
  попробуй {
    ф()
  } поймай е {
    пойманное станет е
    брошено станет истина
  }
  если не брошено то {
    провал("ожидалась ошибка, но функция завершилась без неё")
  }
  если код не равно ничего то {
    если ядро.тип(пойманное) не равно "ошибка" или пойманное.код не равно код то {
      провал("ожидалась ошибка {код}, брошено «{пойманное}»")
    }
  }
  верни пойманное
}

функция _или(сообщение, запасное) {
  если сообщение равно ничего то {
    верни запасное
  }
  верни строка(сообщение)
}
