// сеть — HTTP GET, как fetch в Node (синхронно). Адрес — http:// или https://.

функция получи(адрес: строка) {
  верни ядро.получи(адрес)
}

функция получи_json(адрес: строка) {
  верни ядро.из_json(ядро.получи(адрес))
}

// разрешена ли программе сеть
функция разрешено() {
  верни ядро.сеть_разрешена()
}
