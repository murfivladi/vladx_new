// числа — математика, как Math в JavaScript.
// Корень, пол, потолок, округление и степень считает ядро; остальное написано здесь.

импортируй случай

пусть пи будет 3.141592653589793

функция корень(x: число) {
  верни ядро.корень(x)
}

функция модуль(x: число) {
  если x меньше 0 то {
    верни -x
  }
  верни x
}

функция округли(x: число, знаков = ничего) {
  верни ядро.округли(x, знаков)
}

функция пол(x: число) {
  верни ядро.пол(x)
}

функция потолок(x: число) {
  верни ядро.потолок(x)
}

функция степень(x: число, показатель: число) {
  верни ядро.степень(x, показатель)
}

// минимум(список) или минимум(а, б)
функция минимум(а, б = ничего) {
  пусть все будет _числа(а, б, "минимум")
  изменяй лучшее станет ядро.элемент(все, 0)
  для каждого x из все {
    если x меньше лучшее то {
      лучшее станет x
    }
  }
  верни лучшее
}

функция максимум(а, б = ничего) {
  пусть все будет _числа(а, б, "максимум")
  изменяй лучшее станет ядро.элемент(все, 0)
  для каждого x из все {
    если x больше лучшее то {
      лучшее станет x
    }
  }
  верни лучшее
}

// случайное() — дробь от 0 до 1; случайное(от, до) — целое в границах
функция случайное(нижняя = ничего, верхняя = ничего) {
  если нижняя равно ничего то {
    верни случай.дробь()
  }
  если верхняя равно ничего то {
    ядро.ошибка("E-ARGS-002", "числа.случайное: передайте ничего или две границы (от, до)")
  }
  верни случай.целое(нижняя, верхняя)
}

функция _числа(а, б, кто) {
  пусть все будет _список_из(а, б)
  если ядро.длина(все) равно 0 то {
    ядро.ошибка("E-VALUE-001", "числа.{кто}: пустой список")
  }
  для каждого x из все {
    если ядро.тип(x) не равно "число" то {
      ядро.ошибка("E-TYPE-001", "числа.{кто}: ожидались числа, есть «{x}»")
    }
  }
  верни все
}

функция _список_из(а, б) {
  если ядро.тип(а) равно "список" то {
    верни а
  }
  если б равно ничего то {
    верни [а]
  }
  верни [а, б]
}
