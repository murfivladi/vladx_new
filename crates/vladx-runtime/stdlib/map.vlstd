// словари — как Object.keys/entries и Map в JavaScript.
// Ключ — строка; другие значения становятся строкой.

функция ключи(м: словарь) {
  верни ядро.ключи(м)
}

функция значения(м: словарь) {
  верни ядро.значения(м)
}

// [[ключ, значение], …]
функция пары(м: словарь) {
  пусть итог будет []
  для каждого к из ядро.ключи(м) {
    ядро.добавь(итог, [к, ядро.поле(м, к)])
  }
  верни итог
}

функция есть(м: словарь, ключ) {
  верни ядро.есть_ключ(м, ключ)
}

// значение по ключу из переменной; нет ключа — «по_умолчанию»
функция значение(м: словарь, ключ, по_умолчанию = ничего) {
  если ядро.есть_ключ(м, ключ) то {
    верни ядро.поле(м, ключ)
  }
  верни по_умолчанию
}

// меняет словарь и возвращает его
функция задай(м: словарь, ключ, x) {
  верни ядро.задай_поле(м, ключ, x)
}

// истина, если ключ был
функция удали(м: словарь, ключ) {
  верни ядро.удали_ключ(м, ключ)
}

функция размер(м: словарь) {
  верни ядро.длина(м)
}

// новый словарь: поля а, поверх — поля б
функция объедини(а: словарь, б: словарь) {
  пусть итог будет {}
  для каждого м из [а, б] {
    для каждого к из ядро.ключи(м) {
      ядро.задай_поле(итог, к, ядро.поле(м, к))
    }
  }
  верни итог
}
