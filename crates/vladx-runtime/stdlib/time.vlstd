// время — часы и миллисекунды. Время даёт хост (в браузере — страница).

импортируй строки

функция миллисекунды() {
  верни ядро.миллисекунды()
}

// 3661 → "01:01:01"
функция часы(секунды: число) {
  изменяй t станет ядро.пол(секунды)
  если t меньше 0 то {
    t станет 0
  }
  пусть ч будет ядро.пол(t / 3600)
  пусть м будет ядро.пол(t / 60) % 60
  пусть с будет t % 60
  верни строки.дополни(ч, 2, "0") + ":" + строки.дополни(м, 2, "0") + ":" + строки.дополни(с, 2, "0")
}

// ЧЧ:ММ:СС — время хоста
функция сейчас() {
  пусть с будет ядро.пол(ядро.миллисекунды() / 1000)
  верни часы((с % 86400 + 86400) % 86400)
}
