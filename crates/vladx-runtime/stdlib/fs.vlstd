// файлы — как fs в Node (синхронные функции). Пути — от папки проекта.
// Доступ к файлам проверяет ядро: без разрешения — E-FILE-001.

функция прочитай(путь: строка) {
  верни ядро.прочитай_файл(путь)
}

// создаёт папки по пути; данные любого типа записываются строкой
функция запиши(путь: строка, данные) {
  верни ядро.запиши_файл(путь, строка(данные))
}

// дописать в конец (нет файла — создать)
функция допиши(путь: строка, данные) {
  изменяй было станет ""
  если ядро.есть_файл(путь) то {
    было станет ядро.прочитай_файл(путь)
  }
  верни ядро.запиши_файл(путь, было + строка(данные))
}

функция есть(путь: строка) {
  верни ядро.есть_файл(путь)
}

// все файлы: относительные пути «папка/файл.txt» по алфавиту
функция список() {
  верни ядро.список_файлов()
}

функция удали(путь: строка) {
  верни ядро.удали_файл(путь)
}
