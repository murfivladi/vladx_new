// списки — как методы Array в JavaScript, только функциями модуля.
// Индексы с 0. Функции, которые возвращают список, дают новый — кроме «добавь» и «вынь».

импортируй случай

// меняет список и возвращает его
функция добавь(л: список, x) {
  верни ядро.добавь(л, x)
}

// убирает последний элемент и возвращает его (пустой список — ничего)
функция вынь(л: список) {
  верни ядро.вынь(л)
}

функция размер(л: список) {
  верни ядро.длина(л)
}

функция элемент(л: список, i: число) {
  верни ядро.элемент(л, i)
}

функция первый(л: список) {
  если ядро.длина(л) равно 0 то {
    верни ничего
  }
  верни ядро.элемент(л, 0)
}

функция последний(л: список) {
  пусть n будет ядро.длина(л)
  если n равно 0 то {
    верни ничего
  }
  верни ядро.элемент(л, n - 1)
}

// по возрастанию; сравни(а, б) < 0 — а раньше б
функция отсортируй(л: список, сравни = ничего) {
  если сравни равно ничего то {
    верни ядро.отсортируй(л)
  }
  верни _слиянием(л, сравни)
}

функция _слиянием(л, сравни) {
  пусть n будет ядро.длина(л)
  если n меньше 2 то {
    верни ядро.кусок_списка(л, 0)
  }
  пусть середина будет ядро.пол(n / 2)
  пусть левая будет _слиянием(ядро.кусок_списка(л, 0, середина), сравни)
  пусть правая будет _слиянием(ядро.кусок_списка(л, середина), сравни)
  пусть итог будет []
  изменяй i станет 0
  изменяй j станет 0
  пока i меньше ядро.длина(левая) и j меньше ядро.длина(правая) {
    пусть а будет ядро.элемент(левая, i)
    пусть б будет ядро.элемент(правая, j)
    если сравни(а, б) меньше или равно 0 то {
      ядро.добавь(итог, а)
      i станет i + 1
    } иначе {
      ядро.добавь(итог, б)
      j станет j + 1
    }
  }
  верни итог + ядро.кусок_списка(левая, i) + ядро.кусок_списка(правая, j)
}

функция переверни(л: список) {
  пусть итог будет []
  изменяй i станет ядро.длина(л) - 1
  пока i больше или равно 0 {
    ядро.добавь(итог, ядро.элемент(л, i))
    i станет i - 1
  }
  верни итог
}

// индекс первого равного элемента или -1
функция найди(л: список, x) {
  изменяй i станет 0
  для каждого элем из л {
    если ядро.равны(элем, x) то {
      верни i
    }
    i станет i + 1
  }
  верни -1
}

функция содержит(л: список, x) {
  верни найди(л, x) больше или равно 0
}

// конец не включается
функция кусок(л: список, начало: число, конец = ничего) {
  верни ядро.кусок_списка(л, начало, конец)
}

// соедини(список, "разделитель") → строка; соедини(а, б) → новый список
функция соедини(л: список, второе = "") {
  если ядро.тип(второе) равно "список" то {
    верни л + второе
  }
  если ядро.тип(второе) не равно "строка" то {
    ядро.ошибка("E-TYPE-001", "списки.соедини: ожидалась строка-разделитель или список, получено «{второе}»")
  }
  верни ядро.соедини(л, второе)
}

функция выбери(л: список) {
  верни случай.выбери(л)
}

// элементы, для которых условие истинно
функция отбери(л: список, условие: функция) {
  пусть итог будет []
  для каждого x из л {
    если условие(x) то {
      ядро.добавь(итог, x)
    }
  }
  верни итог
}

функция преобразуй(л: список, ф: функция) {
  пусть итог будет []
  для каждого x из л {
    ядро.добавь(итог, ф(x))
  }
  верни итог
}

// сверни([1, 2, 3], функция(итог, x) { верни итог + x }, 0) → 6
функция сверни(л: список, ф: функция, начало = ничего) {
  изменяй итог станет начало
  изменяй с станет 0
  если начало равно ничего то {
    если ядро.длина(л) равно 0 то {
      верни ничего
    }
    итог станет ядро.элемент(л, 0)
    с станет 1
  }
  для каждого x из ядро.кусок_списка(л, с) {
    итог станет ф(итог, x)
  }
  верни итог
}

функция сумма(л: список) {
  изменяй итог станет 0
  для каждого x из л {
    итог станет итог + x
  }
  верни итог
}

// диапазон(5) → [0, 1, 2, 3, 4]; диапазон(2, 5) → [2, 3, 4]; шаг может быть отрицательным
функция диапазон(начало: число, конец = ничего, шаг: число = 1) {
  изменяй от_ станет начало
  изменяй до_ станет конец
  если конец равно ничего то {
    от_ станет 0
    до_ станет начало
  }
  если шаг равно 0 то {
    ядро.ошибка("E-VALUE-001", "списки.диапазон: шаг не может быть 0")
  }
  пусть итог будет []
  изменяй x станет от_
  пока шаг больше 0 и x меньше до_ или шаг меньше 0 и x больше до_ {
    ядро.добавь(итог, x)
    x станет x + шаг
  }
  верни итог
}
