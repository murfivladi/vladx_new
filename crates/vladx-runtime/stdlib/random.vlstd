// случай — случайные числа. Источник случайности — ядро (с семенем — повторяемо).

функция дробь() {
  верни ядро.дробь()
}

// целое от нижней до верхней границы включительно
функция целое(нижняя: число, верхняя: число) {
  пусть от_ будет ядро.потолок(нижняя)
  пусть до_ будет ядро.пол(верхняя)
  если до_ меньше от_ то {
    ядро.ошибка("E-VALUE-002", "Пустой диапазон: верхняя граница меньше нижней")
  }
  пусть x будет от_ + ядро.пол(ядро.дробь() * (до_ - от_ + 1))
  если x больше до_ то {
    верни до_
  }
  верни x
}

// случайный элемент; пустой список — ничего
функция выбери(л: список) {
  пусть n будет ядро.длина(л)
  если n равно 0 то {
    верни ничего
  }
  изменяй i станет ядро.пол(ядро.дробь() * n)
  если i больше n - 1 то {
    i станет n - 1
  }
  верни ядро.элемент(л, i)
}

// новый список в случайном порядке (тасование Фишера — Йетса)
функция перемешай(л: список) {
  пусть итог будет ядро.кусок_списка(л, 0)
  изменяй i станет ядро.длина(итог) - 1
  пока i больше 0 {
    изменяй j станет ядро.пол(ядро.дробь() * (i + 1))
    если j больше i то {
      j станет i
    }
    пусть т будет ядро.элемент(итог, i)
    ядро.задай_элемент(итог, i, ядро.элемент(итог, j))
    ядро.задай_элемент(итог, j, т)
    i станет i - 1
  }
  верни итог
}
