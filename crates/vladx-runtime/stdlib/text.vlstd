// строки — работа с текстом. Индексы — в символах, с 0.
// Разбиение, склейка, поиск и регистр — в ядре (это горячие операции); остальное — здесь.

функция длина(s: строка) {
  верни ядро.длина(s)
}

функция верхний(s: строка) {
  верни ядро.верхний(s)
}

функция нижний(s: строка) {
  верни ядро.нижний(s)
}

// пробелы по краям
функция обрежь(s: строка) {
  пусть знаки будет ядро.символы(s)
  изменяй начало станет 0
  изменяй конец станет ядро.длина(знаки)
  пока начало меньше конец и ядро.пробельный(ядро.элемент(знаки, начало)) {
    начало станет начало + 1
  }
  пока конец больше начало и ядро.пробельный(ядро.элемент(знаки, конец - 1)) {
    конец станет конец - 1
  }
  верни ядро.кусок_строки(s, начало, конец)
}

// "" — по символам
функция раздели(s: строка, разделитель: строка = " ") {
  верни ядро.раздели(s, разделитель)
}

функция соедини(части: список, разделитель: строка = "") {
  верни ядро.соедини(части, разделитель)
}

функция найди(s: строка, часть: строка, начало: число = 0) {
  верни ядро.найди_в_строке(s, часть, начало)
}

функция содержит(s: строка, часть: строка) {
  верни ядро.найди_в_строке(s, часть) больше или равно 0
}

функция начинается(s: строка, начало: строка) {
  верни ядро.кусок_строки(s, 0, ядро.длина(начало)) равно начало
}

функция заканчивается(s: строка, конец: строка) {
  пусть откуда будет ядро.длина(s) - ядро.длина(конец)
  если откуда меньше 0 то {
    верни ложь
  }
  верни ядро.кусок_строки(s, откуда) равно конец
}

// все вхождения
функция замени(s: строка, что: строка, чем: строка) {
  если что равно "" то {
    верни s
  }
  верни ядро.соедини(ядро.раздели(s, что), чем)
}

// конец не включается
функция кусок(s: строка, начало: число, конец = ничего) {
  верни ядро.кусок_строки(s, начало, конец)
}

функция символ(s: строка, i: число) {
  пусть n будет ядро.длина(s)
  если i меньше 0 или i больше или равно n или i не равно ядро.пол(i) то {
    ядро.ошибка("E-INDEX-001", "Индекс {i} вне строки длиной {n}", "индексы считаются с 0")
  }
  верни ядро.кусок_строки(s, i, i + 1)
}

функция повтори(s: строка, сколько: число) {
  если сколько меньше 0 то {
    ядро.ошибка("E-VALUE-001", "Число повторов не может быть отрицательным")
  }
  если ядро.длина(s) * сколько больше 10000000 то {
    ядро.ошибка("E-VALUE-002", "строки.повтори: слишком длинная строка получится")
  }
  изменяй итог станет ""
  повторяй ядро.пол(сколько) раз {
    итог станет итог + s
  }
  верни итог
}

// слова через любые пробелы
функция слова(s: строка) {
  пусть итог будет []
  изменяй слово станет ""
  для каждого знак из ядро.символы(s) {
    если ядро.пробельный(знак) то {
      если слово не равно "" то {
        ядро.добавь(итог, слово)
        слово станет ""
      }
    } иначе {
      слово станет слово + знак
    }
  }
  если слово не равно "" то {
    ядро.добавь(итог, слово)
  }
  верни итог
}

// дополни(5, 3, "0") → "005": слева до нужной ширины
функция дополни(значение, ширина: число, чем: строка = " ") {
  изменяй итог станет строка(значение)
  если чем равно "" то {
    верни итог
  }
  пока ядро.длина(итог) меньше ширина {
    итог станет чем + итог
  }
  верни итог
}

функция код(знак: строка) {
  верни ядро.код_символа(знак)
}

функция из_кода(n: число) {
  верни ядро.символ_кода(n)
}
