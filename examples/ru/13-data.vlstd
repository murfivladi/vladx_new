// JSON, списки, строки, случайности, время
импортируй json
импортируй списки
импортируй числа
импортируй случай
импортируй время

пусть человек будет { имя: "Аня", город: "Палермо", теги: ["язык", "код"] }
скажи json.запиши(человек)

пусть назад будет json.прочитай(json.запиши(человек))
скажи "имя: {назад.имя}"

пусть оценки будет [5, 2, 9, 1]
скажи списки.отсортируй(оценки)
скажи списки.кусок(оценки, 1, 3)
скажи списки.отбери(оценки, функция(x) {
  верни x больше 2
})
скажи списки.сумма(оценки)
скажи числа.округли(3.7)
скажи случай.перемешай(оценки)
скажи время.часы(3661)
