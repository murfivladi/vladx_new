file.запиши("заметка.txt", "первая строка")

пусть есть будет file.есть("заметка.txt")
скажи "файл есть: {есть}"

пусть текст будет file.прочитай("заметка.txt")
скажи "в файле: {текст}"

пусть список будет file.список()
скажи "в хранилище: {список}"

file.запиши("папка/вложенный.txt", "вложенные папки тоже работают")
