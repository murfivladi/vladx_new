импортируй файлы

файлы.запиши("заметка.txt", "первая строка")

пусть есть будет файлы.есть("заметка.txt")
скажи "файл есть: {есть}"

пусть текст будет файлы.прочитай("заметка.txt")
скажи "в файле: {текст}"

пусть список будет файлы.список()
скажи "в хранилище: {список}"

файлы.запиши("папка/вложенный.txt", "вложенные папки тоже работают")
